# 줄바꿈 통일: 저장소에는 LF로 저장하고, 체크아웃할 때 OS에 맞게 변환한다.
# (Windows에서 수정하지 않은 파일이 전부 변경된 것처럼 보이는 문제 방지)
* text=auto

# Windows 스크립트는 CRLF, 셸 스크립트는 LF 고정
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh  text eol=lf
gradlew text eol=lf

# 바이너리
*.jar  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff  binary
*.woff2 binary
